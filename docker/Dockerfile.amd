# LMCache server image for AMD Instinct (MI325X / MI350).
# Stack: ROCm 7.0.2 (HIP 7.0.51831) from rocm/pytorch base, torch 2.10.0+rocm7.0
# overriding the base's 2.9.1 to match the verified working setup.
# hipcc cross-compiles HIP kernels AOT for gfx942 + gfx950.

ARG BASE_IMAGE=rocm/pytorch:rocm7.0.2_ubuntu24.04_py3.12_pytorch_release_2.9.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin

WORKDIR /workspace

RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx

COPY . /workspace/LMCache
WORKDIR /workspace/LMCache

# Override base's torch 2.9.1 with 2.10.0+rocm7.0.
RUN uv pip install --force-reinstall \
    'torch==2.10.0+rocm7.0' 'torchvision==0.25.0+rocm7.0' \
    --index-url https://download.pytorch.org/whl/rocm7.0

# Install build/cli deps after torch override; torch downgrades setuptools.
RUN uv pip install -r requirements/build.txt -r requirements/cli.txt

RUN python3 -c "import torch; assert torch.version.hip, 'torch is not a ROCm build'; print('TORCH=', torch.__version__, 'HIP=', torch.version.hip)"

ARG PYTORCH_ROCM_ARCH="gfx942 gfx950"
RUN PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" \
    TORCH_DONT_CHECK_COMPILER_ABI=1 \
    CXX=hipcc \
    BUILD_WITH_HIP=1 \
    ROCM_HOME=/opt/rocm \
    HIP_PLATFORM=amd \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_LMCACHE=0.0.0+amd \
    uv pip install -e . --no-build-isolation --verbose

RUN python3 -c "from lmcache.v1.memory_management import lmc_ops; print('lmc_ops OK')"

WORKDIR /workspace
ENTRYPOINT ["lmcache", "server"]
