# Build on internal vLLM-ROCm image so LMCache engine and vLLM workers share
# the same torch+ROCm build (HIP IPC ABI). Mismatched builds cause IPC event
# waits to never wake — engine goes silent under load on MI350.

ARG BASE_IMAGE=gcr.io/character-ai/vllm/vllm-forked-amd:prod_20260507233711
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

COPY . /workspace/LMCache
WORKDIR /workspace/LMCache

# Base uses system Python 3.12; --system targets torch's site-packages.
RUN uv pip install --system -r requirements/build.txt -r requirements/cli.txt

RUN python3 -c "import torch; assert torch.version.hip, 'torch is not a ROCm build'; print('TORCH=', torch.__version__, 'HIP=', torch.version.hip)"

# Fat binary for MI325X (gfx942) + MI350 (gfx950). Placeholder version
# because Cloud Build omits .git.
RUN PYTORCH_ROCM_ARCH="gfx942 gfx950" \
    TORCH_DONT_CHECK_COMPILER_ABI=1 \
    CXX=hipcc \
    BUILD_WITH_HIP=1 \
    ROCM_HOME=/opt/rocm \
    HIP_PLATFORM=amd \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_LMCACHE=0.0.0+amd \
    uv pip install --system -e . --no-build-isolation --verbose

RUN python3 -c "from lmcache.v1.memory_management import lmc_ops; print('lmc_ops OK')"

# Operator hardcodes /opt/venv/bin/lmcache.
RUN mkdir -p /opt/venv/bin && ln -sf /usr/local/bin/lmcache /opt/venv/bin/lmcache

WORKDIR /workspace
ENTRYPOINT ["lmcache", "server"]
