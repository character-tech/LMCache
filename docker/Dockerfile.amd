# LMCache server image built on our internal vLLM-ROCm image so the LMCache
# engine and vLLM workers share the same torch+ROCm build (and therefore the
# same HIP IPC ABI). Mismatched torch builds can cause IPC event waits to
# never wake — observed as the engine going silent under load on MI350.

ARG BASE_IMAGE=gcr.io/character-ai/vllm/vllm-forked-amd:prod_20260507233711
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

COPY . /workspace/LMCache
WORKDIR /workspace/LMCache

# Operator hardcodes /opt/venv/bin/lmcache. --system-site-packages inherits
# the base image's torch instead of pulling a different ROCm wheel.
RUN uv venv --python 3.12 --system-site-packages /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:${PATH}

# Pin torch to whatever the base image installed (e.g. 2.9.1+git8907517) so
# uv doesn't replace it with a PyPI build during `uv pip install -e .` —
# requirements/common.txt declares an unpinned `torch` dep that resolves to
# PyPI's latest CUDA build otherwise, breaking the IPC ABI match we need.
RUN echo "torch==$(python3 -c 'import torch; print(torch.__version__)')" > /tmp/constraints.txt && \
    cat /tmp/constraints.txt

RUN uv pip install -c /tmp/constraints.txt -r requirements/build.txt -r requirements/cli.txt

RUN python3 -c "import torch; assert torch.version.hip, 'torch is not a ROCm build'; print('TORCH=', torch.__version__, 'HIP=', torch.version.hip)"

# Fat binary covering MI325X (gfx942) and MI350 (gfx950). Placeholder version
# because Cloud Build omits .git, breaking setuptools-scm.
RUN PYTORCH_ROCM_ARCH="gfx942 gfx950" \
    TORCH_DONT_CHECK_COMPILER_ABI=1 \
    CXX=hipcc \
    BUILD_WITH_HIP=1 \
    ROCM_HOME=/opt/rocm \
    HIP_PLATFORM=amd \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_LMCACHE=0.0.0+amd \
    uv pip install -c /tmp/constraints.txt -e . --no-build-isolation --verbose

RUN python3 -c "from lmcache.v1.memory_management import lmc_ops; print('lmc_ops OK')"

WORKDIR /workspace
ENTRYPOINT ["lmcache", "server"]
