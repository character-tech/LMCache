# Combined vLLM + LMCache image for AMD GPUs (MI325X / MI350) on ROCm 7.0.
#
# Reproduces the LMCache-team-verified stack (Shaoting Feng, Yihua Cheng):
#   ROCm 7.0.2 (HIP 7.0.51831) + torch 2.10.0+rocm7.0 + vLLM 0.19.0 +
#   LMCache 0.4.4. Our prod stack on rocm7.2 hits hipErrorInvalidDevicePointer
#   on every REGISTER_KV_CACHE; this image isolates the ROCm version.
#
# Build recipe follows the amd4 dev pod's verified-working sequence
# (see dev-pod-lmcache-mp skill, Appendix: optional builds).
#
# Entrypoint defaults to `lmcache server` (drop-in for the operator
# DaemonSet); override `command:` in the vLLM pod to `vllm serve`.

ARG BASE_IMAGE=rocm/dev-ubuntu-24.04:7.0.2-complete
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin
ENV PYTORCH_ROCM_ARCH="gfx942;gfx950"
ENV ROCM_HOME=/opt/rocm
ENV HIP_PLATFORM=amd
ENV UV_HTTP_TIMEOUT=600
ENV UV_LINK_MODE=copy
ENV UV_INDEX_STRATEGY=unsafe-best-match

# vLLM ROCm needs libfmt/libmsgpack/sqlite/pkg-config; torchvision needs
# libjpeg; numpy/scipy need libgfortran5.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        ccache software-properties-common git curl sudo \
        python3.12 python3.12-dev python3.12-venv python3-pip \
        build-essential libnuma-dev tzdata ca-certificates \
        pkg-config libjpeg-dev libgfortran5 \
        sqlite3 libsqlite3-dev libfmt-dev libmsgpack-dev && \
    rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx && \
    uv venv --python python3.12 --seed /opt/venv

# torch 2.10.0+rocm7.0 — matches the base ROCm 7.0.2 runtime.
RUN uv pip install \
        --index-url https://download.pytorch.org/whl/rocm7.0 \
        "torch==2.10.0+rocm7.0" && \
    python3 -c "import torch; assert torch.version.hip; print('TORCH=', torch.__version__, 'HIP=', torch.version.hip)"

WORKDIR /workspace

#################### vLLM (cai-v0.19.0, from ./vllm-src) #####################

# vendored by build_lmcache_vllm_amd.sh — Cloud Build has no GitHub
# credentials for the private character-tech/vllm repo.
ARG MAX_JOBS=2

COPY vllm-src /workspace/vllm
WORKDIR /workspace/vllm

# Strip torch/torchvision/torchaudio pins (and the rocm7.1 extra-index)
# from every requirements/*.txt so the next install does not clobber
# our torch 2.10.0+rocm7.0.
RUN python3 use_existing_torch.py

RUN uv pip install \
        --extra-index-url https://download.pytorch.org/whl/rocm7.0 \
        -r requirements/rocm-build.txt \
        -r requirements/rocm.txt
RUN python3 -c "import torch; assert 'rocm7.0' in torch.__version__, f'expected rocm7.0, got {torch.__version__}'"

# VLLM_VERSION_OVERRIDE: git archive strips .git so setuptools-scm
# cannot infer the version — vLLM's setup.py reads this env var and
# pins SETUPTOOLS_SCM_PRETEND_VERSION before calling get_version().
RUN VLLM_TARGET_DEVICE=rocm MAX_JOBS=${MAX_JOBS} \
    VLLM_VERSION_OVERRIDE=0.19.0 \
    uv pip install -e . --no-build-isolation --verbose

RUN python3 -c "import vllm; print('vLLM =', vllm.__version__)"

#################### flash_attn (triton-AMD backend) #########################

# Required by vLLM MLA init even with ROCM_AITER_MLA. Pinned to the dev-pod
# revision (flash_attn 2.8.3, pre-PR-2230 — avoids the third_party/aiter
# submodule that flash-attention's setup.py would auto-install).
ARG FLASH_ATTN_REPO=https://github.com/Dao-AILab/flash-attention.git
ARG FLASH_ATTN_REF=0e60e39473e8df549a20fb5353760f7a65b30e2d
RUN git clone "${FLASH_ATTN_REPO}" /workspace/flash-attention && \
    cd /workspace/flash-attention && \
    git checkout "${FLASH_ATTN_REF}" && \
    git submodule update --init --recursive csrc/cutlass
WORKDIR /workspace/flash-attention
RUN FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    FLASH_ATTENTION_SKIP_CK_BUILD=TRUE \
    uv pip install --no-build-isolation -e .
# Runtime flag: pick triton-AMD backend, not the CUDA C extension.
ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
RUN python3 -c "from flash_attn import flash_attn_varlen_func; print('flash_attn OK')"

#################### aiter (ROCm fused kernels) ##############################

# Required when VLLM_ROCM_USE_AITER=1. Pinned to dev-pod revision
# (amd-aiter 0.1.10.post2).
ARG AITER_REPO=https://github.com/ROCm/aiter.git
ARG AITER_REF=c3708fb7445899c14cdc6e8055953ee02ed78ddf
RUN git clone "${AITER_REPO}" /workspace/aiter && \
    cd /workspace/aiter && \
    git checkout "${AITER_REF}" && \
    git submodule update --init --recursive
WORKDIR /workspace/aiter
RUN GPU_ARCHS=native uv pip install --no-build-isolation -e .
RUN python3 -c "import aiter; print('aiter OK')"

#################### LMCache (this repo, BUILD_WITH_HIP=1) ###################

COPY . /workspace/LMCache
WORKDIR /workspace/LMCache

RUN uv pip install -r requirements/build.txt -r requirements/cli.txt

# cupy-rocm-7-0: LMCache runtime dep on ROCm 7.0, not in any requirements file.
RUN uv pip install cupy-rocm-7-0

# VERSION_FOR_LMCACHE: Cloud Build context omits .git, so setuptools-scm
# cannot infer a version.
RUN TORCH_DONT_CHECK_COMPILER_ABI=1 \
    CXX=hipcc \
    BUILD_WITH_HIP=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_LMCACHE=0.0.0+amd \
    uv pip install -e . --no-build-isolation --verbose

RUN python3 -c "from lmcache.v1.memory_management import lmc_ops; print('lmc_ops OK')" && \
    python3 -c "import lmcache.c_ops as o; assert hasattr(o, 'record_completion_on_stream'); print('c_ops OK')"

WORKDIR /workspace
ENTRYPOINT ["lmcache", "server"]
